<Window x:Class="MentoriaEstudos.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:MentoriaEstudos.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="Mentora — Mentoria de Estudos"
        Width="1440" Height="860" MinWidth="1100" MinHeight="680"
        WindowStartupLocation="CenterScreen" WindowState="Maximized"
        Background="{StaticResource Fundo}"
        Foreground="{StaticResource Texto}"
        FontFamily="Segoe UI" FontSize="13">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Cabeçalho da marca -->
        <Border Grid.Row="0" Background="{StaticResource Primaria}" Padding="24,12">
            <DockPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="38" Height="38" CornerRadius="10" Background="{StaticResource PrimariaHover}">
                        <Path Data="{StaticResource IconeCapelo}" Style="{StaticResource Icone}"
                              Width="22" Height="22" Stroke="{StaticResource Acento}" />
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Mentora" FontSize="19" FontWeight="Bold"
                                   Foreground="{StaticResource TextoSobrePrimaria}" />
                        <TextBlock Text="Mentoria de estudos · painel de desempenho" FontSize="12"
                                   Foreground="{StaticResource TextoSobrePrimaria}" Opacity="0.7" />
                    </StackPanel>
                </StackPanel>
                <TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center"
                           Text="{Binding NomeAluno}" FontSize="14" FontWeight="SemiBold"
                           Foreground="{StaticResource Acento}" />
            </DockPanel>
        </Border>

        <!-- Identificação: data, mentor, matrícula, aluno, sala -->
        <Border Grid.Row="1" Style="{StaticResource Cartao}" Margin="20,16,20,0" Padding="18,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="190" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="110" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Data" Style="{StaticResource Rotulo}" />
                    <DatePicker SelectedDate="{Binding Data}" />
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Mentor" Style="{StaticResource Rotulo}" />
                    <TextBox Text="{Binding Mentor, UpdateSourceTrigger=PropertyChanged}"
                             Tag="Nome do mentor" />
                </StackPanel>

                <StackPanel Grid.Column="4">
                    <TextBlock Text="Matrícula do aluno" Style="{StaticResource Rotulo}" />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Margin="6,0,0,0" Style="{StaticResource BotaoIcone}"
                                Command="{Binding BuscarAlunoCommand}" ToolTip="Buscar aluno (Enter)">
                            <Path Data="{StaticResource IconeBusca}" Style="{StaticResource Icone}"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Button>
                        <TextBox Text="{Binding Matricula, UpdateSourceTrigger=PropertyChanged}" Tag="Ex.: 20481">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding BuscarAlunoCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                    </DockPanel>
                </StackPanel>

                <StackPanel Grid.Column="6">
                    <TextBlock Text="Nome do aluno" Style="{StaticResource Rotulo}" />
                    <TextBox Text="{Binding NomeAluno, UpdateSourceTrigger=PropertyChanged}"
                             Tag="Preenchido ao buscar a matrícula" />
                </StackPanel>

                <StackPanel Grid.Column="8">
                    <TextBlock Text="Sala" Style="{StaticResource Rotulo}" />
                    <TextBox Text="{Binding Sala, UpdateSourceTrigger=PropertyChanged}" Tag="Ex.: 3º B" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Área principal -->
        <Grid Grid.Row="2" Margin="20,16,20,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.1*" MinWidth="560" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="1*" MinWidth="380" />
            </Grid.ColumnDefinitions>

            <!-- Planilha de simulados -->
            <Border Grid.Column="0" Style="{StaticResource Cartao}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Style="{StaticResource Etiqueta}" Background="{StaticResource AreaLinguagensSuave}">
                                <TextBlock Text="Linguagens" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AreaLinguagens}" />
                            </Border>
                            <Border Style="{StaticResource Etiqueta}" Background="{StaticResource AreaHumanasSuave}">
                                <TextBlock Text="Humanas" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AreaHumanas}" />
                            </Border>
                            <Border Style="{StaticResource Etiqueta}" Background="{StaticResource AreaNaturezaSuave}">
                                <TextBlock Text="Natureza" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AreaNatureza}" />
                            </Border>
                            <Border Style="{StaticResource Etiqueta}" Background="{StaticResource AreaMatematicaSuave}">
                                <TextBlock Text="Matemática" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AreaMatematica}" />
                            </Border>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconeGrafico}" Style="{StaticResource Icone}"
                                  Stroke="{StaticResource Acento}" Width="18" Height="18" VerticalAlignment="Top" Margin="0,1,10,0" />
                            <StackPanel>
                                <TextBlock Text="Desempenho nos simulados" Style="{StaticResource TituloSecao}" />
                                <TextBlock Text="Média por área, acertos por dificuldade (fáceis · médias · difíceis), redação, média final e classificação"
                                           Style="{StaticResource Subtitulo}" />
                            </StackPanel>
                        </StackPanel>
                    </DockPanel>

                    <Grid>
                        <!-- Colunas montadas em MainWindow.xaml.cs (grupos por área) -->
                        <DataGrid x:Name="GradeSimulados" ItemsSource="{Binding Simulados}" FrozenColumnCount="1" />
                        <TextBlock Text="Busque um aluno pela matrícula para ver os resultados dos simulados.">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource EstadoVazio}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasItems, ElementName=GradeSimulados}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </DockPanel>
            </Border>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1.25*" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="1*" />
                </Grid.RowDefinitions>

                <!-- Registro da mentoria -->
                <Border Grid.Row="0" Style="{StaticResource Cartao}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                            <Path Data="{StaticResource IconeCaneta}" Style="{StaticResource Icone}"
                                  Stroke="{StaticResource Acento}" Width="18" Height="18" Margin="0,0,10,0" />
                            <TextBlock Text="Registro da mentoria" Style="{StaticResource TituloSecao}" />
                        </StackPanel>

                        <DockPanel Grid.Row="1" Margin="0,0,0,10">
                            <TextBlock DockPanel.Dock="Top" Text="Análise Técnica" Style="{StaticResource Rotulo}" />
                            <TextBox Style="{StaticResource AreaTexto}"
                                     Text="{Binding AnaliseTecnica, UpdateSourceTrigger=PropertyChanged}"
                                     Tag="Pontos fortes, dificuldades e evolução observados nos simulados…" />
                        </DockPanel>

                        <DockPanel Grid.Row="2" Margin="0,0,0,10">
                            <TextBlock DockPanel.Dock="Top" Text="Indicação de Estudo" Style="{StaticResource Rotulo}" />
                            <TextBox Style="{StaticResource AreaTexto}"
                                     Text="{Binding IndicacaoEstudo, UpdateSourceTrigger=PropertyChanged}"
                                     Tag="Conteúdos, materiais e rotina recomendados ao aluno…" />
                        </DockPanel>

                        <DockPanel Grid.Row="3" Margin="0,0,0,12">
                            <TextBlock DockPanel.Dock="Top" Text="Observações" Style="{StaticResource Rotulo}" />
                            <TextBox Style="{StaticResource AreaTexto}"
                                     Text="{Binding Observacoes, UpdateSourceTrigger=PropertyChanged}"
                                     Tag="Outras anotações sobre o aluno…" />
                        </DockPanel>

                        <DockPanel Grid.Row="4">
                            <Button DockPanel.Dock="Right" Style="{StaticResource BotaoPrimario}"
                                    Command="{Binding SalvarMentoriaCommand}"
                                    ToolTip="Salvar as anotações como relatório no histórico de mentorias">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconeDisquete}" Style="{StaticResource Icone}"
                                          Stroke="{StaticResource TextoSobrePrimaria}" />
                                    <TextBlock Text="Salvar" Margin="8,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <StackPanel VerticalAlignment="Center">
                                <CheckBox Content="Mentoria obrigatória" Style="{StaticResource CaixaSelecao}"
                                          IsChecked="{Binding MentoriaObrigatoria}" />
                                <TextBlock Text="{Binding MensagemStatus}" FontSize="11.5" Margin="0,6,12,0"
                                           Foreground="{StaticResource Destaque}" TextWrapping="Wrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding MensagemStatus}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </DockPanel>
                    </Grid>
                </Border>

                <!-- Histórico de mentorias -->
                <Border Grid.Row="2" Style="{StaticResource Cartao}">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                            <Border DockPanel.Dock="Right" Style="{StaticResource Etiqueta}"
                                    Background="{StaticResource Obrigatoria}">
                                <TextBlock Text="Obrigatória" FontSize="11" FontWeight="SemiBold" Foreground="#8A6A10" />
                            </Border>
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconeHistorico}" Style="{StaticResource Icone}"
                                      Stroke="{StaticResource Acento}" Width="18" Height="18" Margin="0,0,10,0" />
                                <TextBlock Text="Histórico de mentorias" Style="{StaticResource TituloSecao}" />
                            </StackPanel>
                        </DockPanel>

                        <Grid>
                            <DataGrid x:Name="GradeHistorico" ItemsSource="{Binding Historico}" AlternationCount="0">
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                        <Setter Property="ToolTip" Value="{Binding Resumo}" />
                                        <Setter Property="ToolTipService.ShowDuration" Value="60000" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Obrigatoria}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource Obrigatoria}" />
                                                <Setter Property="BorderBrush" Value="{StaticResource Acento}" />
                                                <Setter Property="BorderThickness" Value="3,0,0,0" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.RowStyle>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Data/Hora" Width="118"
                                                        Binding="{Binding DataHora, StringFormat='dd/MM/yyyy HH:mm'}" />
                                    <DataGridTextColumn Header="Mentor" Width="140" Binding="{Binding Mentor}">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Indicação de Estudo" Width="*" MinWidth="160"
                                                        Binding="{Binding IndicacaoEstudo}">
                                        <DataGridTextColumn.HeaderStyle>
                                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                                <Setter Property="HorizontalContentAlignment" Value="Left" />
                                            </Style>
                                        </DataGridTextColumn.HeaderStyle>
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="TextWrapping" Value="Wrap" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock Text="Nenhuma mentoria registrada para este aluno.">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource EstadoVazio}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasItems, ElementName=GradeHistorico}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
