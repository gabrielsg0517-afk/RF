<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RootNamespace>MentoriaEstudos</RootNamespace>
    <AssemblyName>MentoriaEstudos</AssemblyName>
    <Product>Mentora — Mentoria de Estudos</Product>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Data\Sample\dados-exemplo.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
